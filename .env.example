# EmailJS configuration
# Copy this file to .env and fill in your values.
# Get them from https://www.emailjs.com → Account → API Keys / Email Services

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Admin panel visibility
# Set to "true" to expose /admin and /dashboard in the build.
# When false (default) those routes still exist in code but are not linked from the UI.
VITE_ENABLE_ADMIN=false
